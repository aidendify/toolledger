PORT=8080
DATABASE_PATH=/data/toolledger.db
SECRET_KEY=change-me

# Set this on any VPS reachable from the internet. Empty = open admin (local/dev only).
OWNER_PASSWORD=

BUSINESS_NAME=
# Absolute base for QR URLs — no trailing slash. Required for printable labels.
PUBLIC_BASE_URL=http://localhost:8080

# Checkout older than this (hours) appears on missing/overdue list. Default 24.
OVERDUE_HOURS=24

# Optional SMTP. Leave SMTP_HOST unset; custody + CSV still work.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=true
# FROM_EMAIL=
# FROM_NAME=

# Optional Twilio SMS. Leave unset.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Destinations for Notify missing tools (optional).
OWNER_EMAIL=
OWNER_PHONE=

# Optional footer on public /t/{token} only. Leave empty for Verifier / Gumroad.
MARKETING_URL=
